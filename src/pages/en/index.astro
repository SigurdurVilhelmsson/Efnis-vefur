---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroBand from '../../components/HeroBand.astro';
import { getEntry, render } from 'astro:content';
import { paragraphs } from '../../lib/text';

const home = await getEntry('forsida_en', 'en');
if (!home) throw new Error('Missing English homepage file: src/content/forsida/en.md');
const { Content } = await render(home);
---

<BaseLayout lang="en" description={home.data.description} translation="/">
	<HeroBand title={home.data.title}>
		{paragraphs(home.data.intro).map((p) => <p set:html={p} />)}
	</HeroBand>
	<div class="container container--narrow section prose">
		<Content />
	</div>
</BaseLayout>
