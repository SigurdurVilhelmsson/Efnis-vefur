---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import NewsListItem from '../../components/NewsListItem.astro';
import { newsIn } from '../../lib/content';

const items = await newsIn('is');
---

<BaseLayout lang="is" title="Fréttir">
	<PageHero lang="is" title="Fréttir" crumbs={[{ label: 'Forsíða', href: '/' }, { label: 'Fréttir' }]} />
	<div class="container container--narrow section">
		<ul class="list" role="list">
			{items.map(({ entry, urlSlug }) => (
				<li><NewsListItem lang="is" title={entry.data.title} date={entry.data.date} href={`/frettir/${urlSlug}/`} summary={entry.data.summary} headingLevel={2} /></li>
			))}
		</ul>
	</div>
</BaseLayout>

<style>
	.list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
</style>
