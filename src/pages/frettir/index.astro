---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import NewsListItem from '../../components/NewsListItem.astro';
import { news } from '../../data/placeholder';

const items = [...news].sort((a, b) => b.date.getTime() - a.date.getTime());
---

<BaseLayout lang="is" title="Fréttir">
	<PageHero lang="is" title="Fréttir" crumbs={[{ label: 'Forsíða', href: '/' }, { label: 'Fréttir' }]} />
	<div class="container container--narrow section">
		<ul class="list" role="list">
			{items.map((n) => (
				<li><NewsListItem lang="is" title={n.title} date={n.date} href={`/frettir/${n.slug}/`} summary={n.summary} headingLevel={2} /></li>
			))}
		</ul>
	</div>
</BaseLayout>

<style>
	.list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
</style>
