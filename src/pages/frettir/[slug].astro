---
import NewsPage from '../../layouts/NewsPage.astro';
import { newsIn } from '../../lib/content';

export async function getStaticPaths() {
	const english = new Set((await newsIn('en')).map((n) => n.slug));
	return (await newsIn('is')).map(({ entry, slug, urlSlug }) => ({
		params: { slug: urlSlug },
		props: { entry, translation: english.has(slug) ? `/en/frettir/${urlSlug}/` : undefined },
	}));
}

const { entry, translation } = Astro.props;
---

<NewsPage entry={entry} lang="is" translation={translation} />
