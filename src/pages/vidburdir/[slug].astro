---
import EventPage from '../../layouts/EventPage.astro';
import { entriesIn } from '../../lib/content';

export async function getStaticPaths() {
	const english = new Set((await entriesIn('vidburdir', 'en')).map((e) => e.slug));
	return (await entriesIn('vidburdir', 'is')).map(({ entry, slug }) => ({
		params: { slug },
		props: { entry, translation: english.has(slug) ? `/en/vidburdir/${slug}/` : undefined },
	}));
}

const { entry, translation } = Astro.props;
---

<EventPage entry={entry} lang="is" translation={translation} />
