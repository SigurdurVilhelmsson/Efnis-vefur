---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBand from '../components/HeroBand.astro';
import CardGrid from '../components/CardGrid.astro';
import EventBlock from '../components/EventBlock.astro';
import NewsListItem from '../components/NewsListItem.astro';
import RulesCarousel from '../components/RulesCarousel.astro';
import CtaBand from '../components/CtaBand.astro';
import Button from '../components/Button.astro';
import { getEntry } from 'astro:content';
import { eventsIn, getSettings, newsIn } from '../lib/content';
import { getRules } from '../lib/rules';
import { formatNumber } from '../lib/format';
import { paragraphs } from '../lib/text';
import { t } from '../lib/i18n';

const s = t('is');
const home = await getEntry('forsida', 'is');
if (!home) throw new Error('Missing homepage file: src/content/forsida/is.yml');
const copy = home.data;
const settings = await getSettings();
const rules = await getRules();

// "Næsti viðburður" is computed at build time; a daily rebuild (Phase 4)
// makes it roll over when an event has passed.
const nextEvent = (await eventsIn('is')).upcoming[0];

// Featured news first, then the newest.
const news = await newsIn('is');
const latestNews = [...news.filter((n) => n.entry.data.featured), ...news.filter((n) => !n.entry.data.featured)].slice(0, 3);
---

<BaseLayout lang="is" description={copy.hero.tagline} translation="/en/">
	<HeroBand eyebrow={copy.hero.eyebrow} title={copy.hero.title} tagline={copy.hero.tagline}>
		{paragraphs(copy.hero.intro).map((p) => <p set:html={p} />)}
		<Button slot="actions" variant="accent" href="#thumalputtareglur">{s.rules} ↓</Button>
	</HeroBand>

	<div class="section">
		<div class="container">
			<CardGrid cards={copy.cards.map((c) => ({ title: c.title, text: c.text, href: c.link }))} headingLevel={2} />
		</div>
	</div>

	<div class="section section--cream">
		<div class="container split">
			<section aria-labelledby="next-event">
				<h2 id="next-event">{s.nextEvent}</h2>
				{nextEvent
					? <EventBlock lang="is" title={nextEvent.entry.data.title} start={nextEvent.entry.data.start} place={nextEvent.entry.data.place} href={`/vidburdir/${nextEvent.slug}/`} registrationUrl={nextEvent.entry.data.registration_url} />
					: <p class="fallback">{settings.next_event_fallback}</p>}
			</section>

			<section aria-labelledby="latest-news">
				<h2 id="latest-news">{s.news}</h2>
				<ul class="news" role="list">
					{latestNews.map((n) => (
						<li><NewsListItem lang="is" title={n.entry.data.title} date={n.entry.data.date} href={`/frettir/${n.urlSlug}/`} /></li>
					))}
				</ul>
				<p class="all"><a href="/frettir/">{s.allNews}</a></p>
			</section>
		</div>
	</div>

	<RulesCarousel lang="is" rules={rules} title={copy.rules.title} intro={copy.rules.text} href="/thumalputtareglur/" />

	<CtaBand title={copy.membership.title}>
		{paragraphs(copy.membership.text).map((p) => <p set:html={p} />)}
		<p>Árgjald félagsins er {formatNumber(settings.membership_fee, 'is')} kr.</p>
		<Button slot="actions" variant="ghost" href={copy.membership.link}>{copy.membership.link_label} →</Button>
	</CtaBand>
</BaseLayout>

<style>
	.split {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
		gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
	}
	h2 { margin-bottom: 1rem; }
	.fallback {
		background: var(--bg-card);
		border-radius: var(--efnis-radius-md);
		border-left: 3px solid var(--accent);
		padding: 1.5rem;
		margin: 0;
	}
	.news { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
	.news :global(.item) { background: var(--bg-card); }
	.all { margin: 1rem 0 0; font-weight: 600; }
	@media (max-width: 768px) {
		.split { grid-template-columns: 1fr; }
	}
</style>
