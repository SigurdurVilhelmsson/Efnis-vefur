---
import ConferencePage from '../../layouts/ConferencePage.astro';
import { entriesIn } from '../../lib/content';

export async function getStaticPaths() {
	const english = new Set((await entriesIn('radstefnur', 'en')).map((c) => c.slug));
	return (await entriesIn('radstefnur', 'is')).map(({ entry, slug }) => ({
		params: { year: String(entry.data.year) },
		props: { entry, translation: english.has(slug) ? `/en/radstefnur/${entry.data.year}/` : undefined },
	}));
}

const { entry, translation } = Astro.props;
---

<ConferencePage entry={entry} lang="is" translation={translation} />
