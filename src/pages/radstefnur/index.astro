---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CardGrid from '../../components/CardGrid.astro';
import Todo from '../../components/Todo.astro';
import { conferences } from '../../data/placeholder';

const cards = [...conferences]
	.sort((a, b) => b.year - a.year)
	.map((c) => ({ title: `${c.number}. ráðstefna Efnís — ${c.year}`, text: c.theme, href: `/radstefnur/${c.year}/` }));
---

<BaseLayout lang="is" title="Ráðstefnur">
	<PageHero lang="is" title="Ráðstefnur" crumbs={[{ label: 'Forsíða', href: '/' }, { label: 'Ráðstefnur' }]} />
	<div class="container section">
		<div class="container--narrow intro">
			<Todo what="inngangur að ráðstefnum Efnís, og tengill á eldri ráðstefnur (2002–2015) úr WordPress" />
		</div>
		<CardGrid cards={cards} headingLevel={2} columns={3} />
	</div>
</BaseLayout>

<style>
	.intro { margin-bottom: 2rem; padding: 0; }
</style>
