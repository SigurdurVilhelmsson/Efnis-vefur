---
/**
 * Site footer (Footer.jsx → SiteFooter), reduced to what the brief asks for:
 * contact email and links to lög, stjórn and English, plus the main nav.
 */
import EfnisMark from './EfnisMark.astro';
import { getCollection, render } from 'astro:content';
import { getSettings } from '../lib/content';
import { localePath, mainNav, t, type Lang } from '../lib/i18n';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const year = new Date().getFullYear();
const settings = await getSettings();
const emblemTeaser = lang === 'is' ? settings.emblem_teaser : settings.emblem_teaser_en;

// "Merki félagsins →" points at the emblem heading on the About page. The
// heading's id comes from its text, so look it up rather than hard-coding it.
let emblemHref: string | undefined;
const about = (await getCollection('sidur')).find((entry) => entry.id === `um-efnis.${lang}`);
if (about) {
	const { headings } = await render(about);
	const heading = headings.find((h) => /merki|emblem/i.test(h.text));
	emblemHref = localePath('/um-efnis/', lang) + (heading ? `#${heading.slug}` : '');
}
---

<footer class="site-footer on-dark">
	<div class="container grid">
		<div class="about">
			<p class="brand">
				<EfnisMark size={32} reversed />
				<span lang="is">{t('is').siteName}</span>
			</p>
			<p>{lang === 'is' ? 'Reykjavík · stofnað 1999' : 'Reykjavík · founded 1999'}</p>
			<p>
				<span class="visually-hidden">{s.contact}: </span>
				<a href={`mailto:${settings.contact_email}`}>{settings.contact_email}</a>
			</p>
			<p class="emblem">
				{emblemTeaser}
				{emblemHref && <>{' '}<a href={emblemHref}>{s.emblemMore} →</a></>}
			</p>
		</div>

		{mainNav[lang].length > 0 && (
			<nav aria-labelledby="footer-quick">
				<h2 id="footer-quick">{s.footerQuickLinks}</h2>
				<ul>
					{mainNav[lang].map((item) => <li><a href={item.href}>{item.label}</a></li>)}
				</ul>
			</nav>
		)}

		<nav aria-labelledby="footer-about">
			<h2 id="footer-about">{s.footerAbout}</h2>
			<ul>
				<li><a href="/um-efnis/log/" hreflang="is">{s.bylaws}</a></li>
				<li><a href="/um-efnis/stjorn/" hreflang="is">{s.board}</a></li>
				{lang === 'is'
					? <li><a href="/en/" lang="en" hreflang="en">English</a></li>
					: <li><a href="/" lang="is" hreflang="is">Íslenska</a></li>}
			</ul>
		</nav>
	</div>
	<div class="container bottom">
		<span>© {year} {t('is').siteName}</span>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--efnis-basalt);
		/* Contrast: ≥ 85% cream on basalt (9.7:1). */
		color: rgba(243, 239, 230, 0.85);
		padding: 3rem 0 2rem;
		font-size: 0.9rem;
	}
	.grid {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: 2rem;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-family: var(--font-serif);
		font-weight: 700;
		font-size: 1.05rem;
		color: #fff;
		margin-bottom: 0.75rem;
	}
	.about p:not(.brand) { max-width: 44ch; margin-bottom: 0.5rem; }
	.emblem { margin-top: 1rem; font-size: 0.85rem; }
	.emblem a { white-space: nowrap; }
	h2 {
		color: #fff;
		font-size: 0.95rem;
		margin: 0 0 0.75rem;
	}
	ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.35rem; }
	a { color: rgba(243, 239, 230, 0.85); }
	a:hover { color: #fff; }
	.bottom {
		margin-top: 2rem;
		padding-top: 1.5rem;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		font-size: 0.8rem;
	}
	@media (max-width: 768px) {
		.grid { grid-template-columns: 1fr; }
	}
</style>
