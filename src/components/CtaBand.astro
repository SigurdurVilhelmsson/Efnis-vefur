---
/** Dark call-out band (Footer.jsx → CtaBand); used for membership info. */
interface Props {
	title: string;
	id?: string;
}
const { title, id } = Astro.props;
---

<section class="cta on-dark" id={id} aria-labelledby="cta-title">
	<div class="container">
		<h2 id="cta-title">{title}</h2>
		<div class="text"><slot /></div>
		<div class="actions"><slot name="actions" /></div>
	</div>
</section>

<style>
	.cta {
		background: var(--efnis-gradient-hero);
		color: #fff;
		text-align: center;
		padding: 3.5rem 0;
	}
	h2 { color: #fff; font-size: var(--text-xl); margin-bottom: 0.75rem; }
	.text { color: rgba(255, 255, 255, 0.9); max-width: 640px; margin: 0 auto 1.5rem; }
	.text :global(p) { margin: 0; }
	.text :global(p + p) { margin-top: 0.75rem; }
</style>
