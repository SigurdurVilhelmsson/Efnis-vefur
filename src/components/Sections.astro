---
/** Renders page copy stored as Section objects (src/data/sections.ts). */
import type { Section } from '../data/sections';
import { inlineMarkdown } from '../lib/text';

interface Props {
	sections: Section[];
}
const { sections } = Astro.props;
---

{sections.map((sec) => (
	<section id={sec.id} class="copy-section">
		{sec.heading && <h2>{sec.heading}</h2>}
		{sec.paragraphs?.map((p) => <p set:html={inlineMarkdown(p)}></p>)}
		{sec.list && <ul>{sec.list.map((li) => <li set:html={inlineMarkdown(li)}></li>)}</ul>}
		{sec.after?.map((p) => <p set:html={inlineMarkdown(p)}></p>)}
		{sec.lines && <p set:html={sec.lines.map(inlineMarkdown).join('<br />')}></p>}
		{sec.links && (
			<p class="links">
				{sec.links.map((l, i) => (
					<>
						{i > 0 && ' · '}
						<a href={l.href}>{l.label} →</a>
					</>
				))}
			</p>
		)}
	</section>
))}

<style>
	.copy-section + .copy-section { margin-top: 2.5rem; }
	.copy-section > :global(* + *) { margin-top: 1em; }
	.links { font-weight: 600; }
</style>
